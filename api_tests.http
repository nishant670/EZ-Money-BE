@baseUrl = http://localhost:8080

### 1. Health Check
GET {{baseUrl}}/health

### 2. Create Guest User
# Creates a new shadow account. Save the token from the response.
POST {{baseUrl}}/v1/auth/guest

### 3. Identify User (Check if exists)
POST {{baseUrl}}/v1/auth/identify
Content-Type: application/json

{
    "identifier": "+919876543210"
}

### 4. Send OTP
# For local manual testing, set OTP_DEBUG_RESPONSE=true and use dev_otp from the response.
POST {{baseUrl}}/v1/auth/otp/send
Content-Type: application/json

{
    "identifier": "+919876543210"
}

### 5. Verify OTP
# Returns a claim_token needed for registration
POST {{baseUrl}}/v1/auth/otp/verify
Content-Type: application/json

{
    "identifier": "+919876543210",
    "otp": "<dev_otp>"
}

### 6. Register User
# Replace claim_token with the opaque token received from step 5
POST {{baseUrl}}/v1/auth/register
Content-Type: application/json

{
    "claim_token": "<claim_token>",
    "pin": "1234"
}

### 7. Login
POST {{baseUrl}}/v1/auth/login
Content-Type: application/json

{
    "identifier": "+919876543210",
    "pin": "1234"
}
