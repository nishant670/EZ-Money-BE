PORT=8080
ALLOW_ORIGINS=*
AUTH_BEARER=
TZ_DEFAULT=Asia/Kolkata

# Keep this secret server-side. Never put it in the mobile or web app.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=gpt-4o-mini-transcribe
OPENAI_MAX_OUTPUT_TOKENS=600

REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
MAX_UPLOAD_MB=15
MAX_TRANSCRIPT_CHARS=1000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=finnri
DB_SSLMODE=disable
