PORT=8080
# Comma-separated exact browser origins. Do not use "*".
ALLOW_ORIGINS=http://localhost:3000,http://localhost:8081
AUTH_BEARER=
TZ_DEFAULT=Asia/Kolkata

# Keep this secret server-side. Never put it in the mobile or web app.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=gpt-4o-mini-transcribe
OPENAI_MAX_OUTPUT_TOKENS=600

REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
MAX_JSON_KB=64
MAX_UPLOAD_MB=15
MAX_TRANSCRIPT_CHARS=1000

# Development only. When true, /v1/auth/otp/send includes dev_otp in the response.
OTP_DEBUG_RESPONSE=false
OTP_EXPIRES_MINUTES=10
CLAIM_TOKEN_EXPIRES_MINUTES=15

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=finnri
DB_SSLMODE=disable
