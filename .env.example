# FINNRI backend environment template.
# Copy to .env for local development. Keep real secrets out of Git.

# Required server settings.
PORT=8080
TZ_DEFAULT=Asia/Kolkata

# Required for browser clients. Comma-separated exact origins; do not use "*".
ALLOW_ORIGINS=http://localhost:3000,http://localhost:8081

# Optional legacy shared bearer for non-user-token internal routes.
AUTH_BEARER=

# Required AI provider secret. Replace in .env; do not commit the real key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=gpt-4o-mini-transcribe
OPENAI_MAX_OUTPUT_TOKENS=600

# Required request safety limits.
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
MAX_JSON_KB=64
MAX_UPLOAD_MB=15
MAX_TRANSCRIPT_CHARS=1000

# Required auth verification settings.
# Development only: when true, /v1/auth/otp/send includes dev_otp in the response.
OTP_DEBUG_RESPONSE=false
OTP_EXPIRES_MINUTES=10
CLAIM_TOKEN_EXPIRES_MINUTES=15

# Required database connection settings. Replace DB_PASSWORD in .env.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=finnri
DB_SSLMODE=disable

# Required only when applying checked-in migrations with psql.
# Example format: postgres://user:password@host:5432/dbname?sslmode=disable
DATABASE_URL=
